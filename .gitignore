# Local clones of upstream reference repos. Not part of this repo's history.
reference/

# mdBook build output (per book.toml build-dir = "book").
book/book/

# Cargo build artifacts (any crate under the tree).
target/

# Claude Code machine-local settings (the .claude/ dir itself IS tracked
# for shared config like mcp.json; the *.local.json files are not).
.claude/*.local.json

# Python virtual environments, bytecode caches, and editable-install metadata.
# Applies repo-wide — orchestrator/, tools/, and any future Python project.
**/.venv/
**/__pycache__/
**/*.pyc
**/*.egg-info/

# File-based meta-review handshake — never committed; the file is the human
# approval interface and gets cleared by the orchestrator after enactment.
meta-review-pending.md

# Secrets / credentials — never committed. The orchestrator reads
# ANTHROPIC_API_KEY from the process environment, not from any file in
# the repo, but if you set up direnv / a dotenv loader, these patterns
# keep the key out of git.
.env
.env.*
.envrc
*.secret
*.secrets
**/credentials.json
