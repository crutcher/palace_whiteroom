# Template for a local `.env` file at the repo root.
# Copy to `.env` (already gitignored) and paste your key:
#   cp .env.example .env
#   $EDITOR .env
#
# The orchestrator loads .env at startup. Live shell env wins if both
# are set (so `export ANTHROPIC_API_KEY=...` in your shell takes
# precedence over the .env value).

# Either form is accepted by the orchestrator's loader:
#   ANTHROPIC_API_KEY=sk-ant-...
#   export ANTHROPIC_API_KEY=sk-ant-...        # also works (`source .env`-compatible)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the repo root (otherwise auto-detected by walking
# up from CWD looking for config.toml + BOOTSTRAP.md).
# PALACE_WHITEROOM_ROOT=/path/to/palace_whiteroom

# Optional: increase Python / SDK logging verbosity.
# RUST_LOG=info       # for the codemap MCP server's stderr logs
# ANTHROPIC_LOG=debug # for SDK-side request logging (do NOT enable
                     # if you don't want request bodies in logs)
